    ->             WHEN 'Clerk' THEN SET daily_wage = 750.00;
    ->             WHEN 'Programmer' THEN SET daily_wage = 1250.00;
    ->             ELSE SET daily_wage = 0.00;
    ->         END CASE;
    -> 
    ->         -- Calculate salary
    ->         SET emp_salary = daily_wage * working_days_val;
